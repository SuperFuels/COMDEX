import Mathlib.NumberTheory.LSeries.Nonvanishing
import Mathlib.NumberTheory.LSeries.ZetaZeros
import Mathlib.NumberTheory.Harmonic.ZetaAsymp

namespace RiemannLab

/-!
Definitions and established critical-strip consequences for nontrivial zeros of
the Riemann zeta function. These results reconstruct classical mathematics from
the pinned Mathlib library; they are not new results about RH.
-/

/-- A trivial zeta zero is a negative even integer in the standard indexed form. -/
def IsTrivialZetaZero (s : ℂ) : Prop :=
  ∃ n : ℕ, s = -2 * (n + 1)

/-- A nontrivial zeta zero is a zero outside the negative-even family. -/
def IsNontrivialZetaZero (s : ℂ) : Prop :=
  riemannZeta s = 0 ∧ ¬IsTrivialZetaZero s

/-- Every zeta zero in the closed left half-plane is a trivial zero. -/
theorem zeta_zero_of_re_nonpos_is_trivial {s : ℂ}
    (hz : riemannZeta s = 0) (hsre : s.re ≤ 0) : IsTrivialZetaZero s := by
  have hs0 : s ≠ 0 := by
    intro hs
    subst s
    have hzero : riemannZeta 0 ≠ 0 := by
      rw [riemannZeta_zero]
      norm_num
    exact hzero hz
  have ht_re : 1 ≤ (1 - s).re := by
    change 1 ≤ 1 - s.re
    linarith
  have ht0 : 1 - s ≠ 0 := by
    intro ht
    have ht_re_zero : (1 - s).re = 0 := congrArg Complex.re ht
    change 1 - s.re = 0 at ht_re_zero
    linarith
  have ht_zeta : riemannZeta (1 - s) ≠ 0 :=
    riemannZeta_ne_zero_of_one_le_re ht_re
  have ht_completed : completedRiemannZeta (1 - s) ≠ 0 := by
    intro ht
    apply ht_zeta
    rw [riemannZeta_def_of_ne_zero ht0, ht, zero_div]
  have hs_completed : completedRiemannZeta s ≠ 0 := by
    rw [← completedRiemannZeta_one_sub s]
    exact ht_completed
  have hs_gamma : Complex.Gammaℝ s = 0 := by
    have hdiv := hz
    rw [riemannZeta_def_of_ne_zero hs0] at hdiv
    exact (div_eq_zero_iff.mp hdiv).resolve_left hs_completed
  rcases Complex.Gammaℝ_eq_zero_iff.mp hs_gamma with ⟨n, hn⟩
  rcases n with _ | n
  · simp only [Nat.cast_zero, mul_zero, neg_zero] at hn
    exact (hs0 hn).elim
  · refine ⟨n, ?_⟩
    simpa [Nat.cast_add, mul_add, add_comm] using hn

/-- A nontrivial zero lies strictly to the right of the imaginary axis. -/
theorem IsNontrivialZetaZero.re_pos {s : ℂ} (hs : IsNontrivialZetaZero s) :
    0 < s.re := by
  by_contra hre
  exact hs.2 (zeta_zero_of_re_nonpos_is_trivial hs.1 (le_of_not_gt hre))

/-- A nontrivial zero lies strictly to the left of the line `re = 1`. -/
theorem IsNontrivialZetaZero.re_lt_one {s : ℂ} (hs : IsNontrivialZetaZero s) :
    s.re < 1 := by
  by_contra hre
  exact riemannZeta_ne_zero_of_one_le_re (le_of_not_gt hre) hs.1

/-- Kernel-checked reconstruction of the classical critical-strip theorem. -/
theorem IsNontrivialZetaZero.mem_critical_strip {s : ℂ}
    (hs : IsNontrivialZetaZero s) : 0 < s.re ∧ s.re < 1 :=
  ⟨hs.re_pos, hs.re_lt_one⟩

/-- The functional equation reflects every nontrivial zero across `re = 1 / 2`. -/
theorem IsNontrivialZetaZero.one_sub_zero {s : ℂ}
    (hs : IsNontrivialZetaZero s) : riemannZeta (1 - s) = 0 := by
  have hs_nat : ∀ n : ℕ, s ≠ -n := by
    intro n hn
    have hre : s.re ≤ 0 := by
      rw [hn]
      simp
    exact (not_lt_of_ge hre hs.re_pos)
  have hs1 : s ≠ 1 := by
    intro h
    subst s
    exact (riemannZeta_ne_zero_of_one_le_re (by norm_num)) hs.1
  rw [riemannZeta_one_sub hs_nat hs1, hs.1, mul_zero]

/-- Reflection preserves nontriviality. -/
theorem IsNontrivialZetaZero.one_sub {s : ℂ}
    (hs : IsNontrivialZetaZero s) : IsNontrivialZetaZero (1 - s) := by
  refine ⟨hs.one_sub_zero, ?_⟩
  intro htrivial
  rcases htrivial with ⟨n, hn⟩
  have hreflect_pos : 0 < (1 - s).re := by
    change 0 < 1 - s.re
    linarith [hs.re_lt_one]
  have hreflect_nonpos : (1 - s).re ≤ 0 := by
    rw [hn]
    norm_num
    positivity
  exact (not_lt_of_ge hreflect_nonpos hreflect_pos)

/-- Complex conjugation preserves nontrivial zeta zeros. -/
theorem IsNontrivialZetaZero.conj {s : ℂ}
    (hs : IsNontrivialZetaZero s) : IsNontrivialZetaZero (starRingEnd ℂ s) := by
  refine ⟨?_, ?_⟩
  · rw [riemannZeta_conj, hs.1, map_zero]
  · intro htrivial
    rcases htrivial with ⟨n, hn⟩
    have hconj_pos : 0 < (starRingEnd ℂ s).re := by
      simpa using hs.re_pos
    have hconj_nonpos : (starRingEnd ℂ s).re ≤ 0 := by
      rw [hn]
      norm_num
      positivity
    exact not_lt_of_ge hconj_nonpos hconj_pos

/-- The four standard points generated by reflection and conjugation are nontrivial zeros. -/
theorem IsNontrivialZetaZero.symmetry_orbit {s : ℂ}
    (hs : IsNontrivialZetaZero s) :
    IsNontrivialZetaZero s ∧
      IsNontrivialZetaZero (starRingEnd ℂ s) ∧
      IsNontrivialZetaZero (1 - s) ∧
      IsNontrivialZetaZero (1 - starRingEnd ℂ s) :=
  ⟨hs, hs.conj, hs.one_sub, hs.conj.one_sub⟩

/-- Our nontrivial-zero formulation is equivalent to Mathlib's statement of RH. -/
theorem riemannHypothesis_iff_nontrivial_zeros :
    RiemannHypothesis ↔
      ∀ s : ℂ, IsNontrivialZetaZero s → s.re = 1 / 2 := by
  constructor
  · intro h s hs
    apply h s hs.1 hs.2
    intro hs1
    subst s
    exact (riemannZeta_ne_zero_of_one_le_re (by norm_num)) hs.1
  · intro h s hz htrivial _hs1
    exact h s ⟨hz, htrivial⟩

end RiemannLab
