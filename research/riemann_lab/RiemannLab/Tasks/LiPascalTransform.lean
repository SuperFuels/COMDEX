import RiemannLab.Tasks.LiWeilBasis

namespace RiemannLab

open scoped BigOperators

/-!
# Pascal coordinates for Li modes

The Li coefficients are a binomial transform of reciprocal-zero power sums.
This file records the finite algebra behind undoing that transform.  It does
not perform the analytic zero sum and makes no assumption about RH.
-/

/-- The alternating Pascal transform of a geometric sequence isolates one
power.  This is the algebraic core of the reciprocal-zero coordinate change. -/
theorem inversePascal_geometric (x : ℂ) (n : ℕ) :
    (∑ k ∈ Finset.range (n + 1),
        (n.choose k : ℂ) * (-1 : ℂ) ^ (n - k) * (1 - x) ^ k) =
      (-x) ^ n := by
  have h := (add_pow (1 - x) (-1 : ℂ) n).symm
  rw [show (1 - x) + (-1 : ℂ) = -x by ring] at h
  simpa [mul_comm, mul_left_comm, mul_assoc] using h

/-- Therefore inverse Pascal transformation sends the elementary Li mode
`1 - (1-x)^k` to a signed monomial, apart from the exceptional zeroth row. -/
theorem inversePascal_liMode (x : ℂ) (n : ℕ) (hn : n ≠ 0) :
    (∑ k ∈ Finset.range (n + 1),
        (n.choose k : ℂ) * (-1 : ℂ) ^ (n - k) * (1 - (1 - x) ^ k)) =
      -(-x) ^ n := by
  simp_rw [mul_sub]
  rw [Finset.sum_sub_distrib]
  have hconstant :
      (∑ k ∈ Finset.range (n + 1),
          (n.choose k : ℂ) * (-1 : ℂ) ^ (n - k) * 1) = 0 := by
    simpa [mul_comm, mul_left_comm, mul_assoc, hn] using
      (add_pow (1 : ℂ) (-1) n).symm
  rw [hconstant, inversePascal_geometric]
  ring

/-- Applied to the actual Li zero mode, Pascal inversion exposes the reciprocal
power `ρ⁻ⁿ` (up to the explicit alternating sign). -/
theorem inversePascal_liZeroMode (ρ : ℂ) (n : ℕ) (hn : n ≠ 0) :
    (∑ k ∈ Finset.range (n + 1),
        (n.choose k : ℂ) * (-1 : ℂ) ^ (n - k) * liZeroMode k ρ) =
      -(-ρ⁻¹) ^ n := by
  simpa [liZeroMode] using inversePascal_liMode ρ⁻¹ n hn

/-- The entries of the inverse Pascal coordinate transform.  Values above the
natural triangular support vanish automatically because `n.choose k = 0`. -/
noncomputable def inversePascalWeight (n k : ℕ) : ℂ :=
  (n.choose k : ℂ) * (-1 : ℂ) ^ (n - k)

/-- Every nonzeroth inverse-Pascal row has total mass zero. -/
theorem sum_inversePascalWeight_eq_zero (n : ℕ) (hn : n ≠ 0) :
    ∑ k ∈ Finset.range (n + 1), inversePascalWeight n k = 0 := by
  unfold inversePascalWeight
  simpa [mul_comm, mul_left_comm, mul_assoc, hn] using
    (add_pow (1 : ℂ) (-1) n).symm

/-- The complex centered distance entry generated by one Li zero mode. -/
noncomputable def centeredLiZeroMode (ρ : ℂ) (i j : ℕ) : ℂ :=
  liZeroMode i ρ + liZeroMode j ρ -
    liZeroMode ((i - j) + (j - i)) ρ

/-- Before summation, a centered Li mode consists of three separable terms and
one Toeplitz term depending only on the discrete distance. -/
theorem centeredLiZeroMode_eq_geometric (ρ : ℂ) (i j : ℕ) :
    centeredLiZeroMode ρ i j =
      1 - (1 - ρ⁻¹) ^ i - (1 - ρ⁻¹) ^ j +
        (1 - ρ⁻¹) ^ ((i - j) + (j - i)) := by
  unfold centeredLiZeroMode liZeroMode
  ring

/-- Double summation against two zero-mass rows kills every separable part of
a centered kernel, leaving only its genuinely two-variable term. -/
theorem doubleCentered_sum_eq_toeplitz
    (s t : Finset ℕ) (a b u v : ℕ → ℂ) (w : ℕ → ℕ → ℂ)
    (ha : ∑ i ∈ s, a i = 0) (hb : ∑ j ∈ t, b j = 0) :
    (∑ i ∈ s, ∑ j ∈ t,
        a i * b j * (1 - u i - v j + w i j)) =
      ∑ i ∈ s, ∑ j ∈ t, a i * b j * w i j := by
  classical
  have hconstant :
      (∑ i ∈ s, ∑ j ∈ t, a i * b j) = 0 := by
    rw [← Finset.sum_mul_sum, ha, hb]
    simp
  have hu :
      (∑ i ∈ s, ∑ j ∈ t, a i * b j * u i) = 0 := by
    calc
      (∑ i ∈ s, ∑ j ∈ t, a i * b j * u i) =
          (∑ i ∈ s, a i * u i) * (∑ j ∈ t, b j) := by
            rw [Finset.sum_mul_sum]
            apply Finset.sum_congr rfl
            intro i hi
            apply Finset.sum_congr rfl
            intro j hj
            ring
      _ = 0 := by rw [hb, mul_zero]
  have hv :
      (∑ i ∈ s, ∑ j ∈ t, a i * b j * v j) = 0 := by
    calc
      (∑ i ∈ s, ∑ j ∈ t, a i * b j * v j) =
          (∑ i ∈ s, a i) * (∑ j ∈ t, b j * v j) := by
            rw [Finset.sum_mul_sum]
            apply Finset.sum_congr rfl
            intro i hi
            apply Finset.sum_congr rfl
            intro j hj
            ring
      _ = 0 := by rw [ha, zero_mul]
  calc
    (∑ i ∈ s, ∑ j ∈ t,
        a i * b j * (1 - u i - v j + w i j)) =
        (∑ i ∈ s, ∑ j ∈ t, a i * b j) -
        (∑ i ∈ s, ∑ j ∈ t, a i * b j * u i) -
        (∑ i ∈ s, ∑ j ∈ t, a i * b j * v j) +
        (∑ i ∈ s, ∑ j ∈ t, a i * b j * w i j) := by
          simp_rw [mul_add, mul_sub, Finset.sum_add_distrib,
            Finset.sum_sub_distrib]
          ring
    _ = ∑ i ∈ s, ∑ j ∈ t, a i * b j * w i j := by
      rw [hconstant, hu, hv]
      ring

/-- The naturally truncated two-index Pascal transform of a centered Li zero
mode. -/
noncomputable def inversePascalLiKernel (ρ : ℂ) (n m : ℕ) : ℂ :=
  ∑ i ∈ Finset.range (n + 1), ∑ j ∈ Finset.range (m + 1),
    inversePascalWeight n i * inversePascalWeight m j *
      centeredLiZeroMode ρ i j

/-- Once both Pascal rows have zero mass, the full centered Li kernel reduces
exactly to the transform of the Toeplitz geometric kernel
`(1-ρ⁻¹)^|i-j|`.  No zero-location hypothesis is used. -/
theorem inversePascalLiKernel_eq_toeplitz
    (ρ : ℂ) (n m : ℕ) (hn : n ≠ 0) (hm : m ≠ 0) :
    inversePascalLiKernel ρ n m =
      ∑ i ∈ Finset.range (n + 1), ∑ j ∈ Finset.range (m + 1),
        inversePascalWeight n i * inversePascalWeight m j *
          (1 - ρ⁻¹) ^ ((i - j) + (j - i)) := by
  unfold inversePascalLiKernel
  simp_rw [centeredLiZeroMode_eq_geometric]
  exact doubleCentered_sum_eq_toeplitz
    (Finset.range (n + 1)) (Finset.range (m + 1))
    (inversePascalWeight n) (inversePascalWeight m)
    (fun i => (1 - ρ⁻¹) ^ i) (fun j => (1 - ρ⁻¹) ^ j)
    (fun i j => (1 - ρ⁻¹) ^ ((i - j) + (j - i)))
    (sum_inversePascalWeight_eq_zero n hn)
    (sum_inversePascalWeight_eq_zero m hm)

/-- Finite congruence of an arbitrary kernel by the inverse Pascal matrix. -/
noncomputable def inversePascalKernel
    (s : Finset ℕ) (K : ℕ → ℕ → ℂ) (n m : ℕ) : ℂ :=
  ∑ i ∈ s, ∑ j ∈ s,
    inversePascalWeight n i * inversePascalWeight m j * K i j

/-- Pull a coefficient vector back through the transpose of the inverse
Pascal matrix. -/
noncomputable def inversePascalPullback
    (s : Finset ℕ) (c : ℕ → ℂ) (i : ℕ) : ℂ :=
  ∑ n ∈ s, c n * inversePascalWeight n i

/-- Congruence does not change the underlying finite quadratic form: it only
changes coordinates.  This is the exact finite bridge from the transformed
kernel back to the original Li--Gram kernel. -/
theorem inversePascalKernel_quadraticForm
    (s : Finset ℕ) (K : ℕ → ℕ → ℂ) (c : ℕ → ℂ) :
    (∑ n ∈ s, ∑ m ∈ s,
        c n * c m * inversePascalKernel s K n m) =
      ∑ i ∈ s, ∑ j ∈ s,
        inversePascalPullback s c i * inversePascalPullback s c j * K i j := by
  classical
  simp only [inversePascalKernel, inversePascalPullback]
  simp_rw [Finset.mul_sum, Finset.sum_mul]
  calc
    _ = ∑ n ∈ s, ∑ m ∈ s, ∑ i ∈ s, ∑ j ∈ s,
          c n * c m * inversePascalWeight n i * inversePascalWeight m j * K i j := by
      apply Finset.sum_congr rfl
      intro n hn
      apply Finset.sum_congr rfl
      intro m hm
      apply Finset.sum_congr rfl
      intro i hi
      apply Finset.sum_congr rfl
      intro j hj
      ring
    _ = ∑ n ∈ s, ∑ i ∈ s, ∑ m ∈ s, ∑ j ∈ s,
          c n * c m * inversePascalWeight n i * inversePascalWeight m j * K i j := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [Finset.sum_comm]
    _ = ∑ i ∈ s, ∑ n ∈ s, ∑ m ∈ s, ∑ j ∈ s,
          c n * c m * inversePascalWeight n i * inversePascalWeight m j * K i j := by
      rw [Finset.sum_comm]
    _ = ∑ i ∈ s, ∑ n ∈ s, ∑ j ∈ s, ∑ m ∈ s,
          c n * c m * inversePascalWeight n i * inversePascalWeight m j * K i j := by
      apply Finset.sum_congr rfl
      intro i hi
      apply Finset.sum_congr rfl
      intro n hn
      rw [Finset.sum_comm]
    _ = ∑ i ∈ s, ∑ j ∈ s, ∑ n ∈ s, ∑ m ∈ s,
          c n * c m * inversePascalWeight n i * inversePascalWeight m j * K i j := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [Finset.sum_comm]
    _ = ∑ i ∈ s, ∑ j ∈ s, ∑ m ∈ s, ∑ n ∈ s,
          c n * c m * K i j * inversePascalWeight n i * inversePascalWeight m j := by
      apply Finset.sum_congr rfl
      intro i hi
      apply Finset.sum_congr rfl
      intro j hj
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro m hm
      apply Finset.sum_congr rfl
      intro n hn
      ring
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i hi
      apply Finset.sum_congr rfl
      intro j hj
      apply Finset.sum_congr rfl
      intro m hm
      apply Finset.sum_congr rfl
      intro n hn
      ring

end RiemannLab
