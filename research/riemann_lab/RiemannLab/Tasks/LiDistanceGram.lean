import RiemannLab.Tasks.LiQuartetDefect

namespace RiemannLab

open scoped BigOperators

/-!
# A distance-Gram form for Li positivity

For a unit-circle zero mode, `1 - cos θ` behaves as half a squared chord
length.  Centering its distance kernel produces an explicit rank-two Gram
matrix.  This is the structural reason for testing

`G i j = λ i + λ j - λ |i-j|`.

The statements here are finite real identities.  Applying them to the full
zeta zero divisor still requires the analytic Li criterion and its limiting
convention; no use of RH is made in this file.
-/

/-- The real Li contribution of one unit-circle angle. -/
noncomputable def liAngleMode (x : ℝ) : ℝ := 1 - Real.cos x

/-- The centered distance entry generated by a single angle. -/
noncomputable def liAngleGramEntry (x y : ℝ) : ℝ :=
  liAngleMode x + liAngleMode y - liAngleMode (x - y)

/-- The centered distance matrix associated with an arbitrary real sequence. -/
def centeredSequenceEntry (a : ℕ → ℝ) (i j : ℕ) : ℝ :=
  a i + a j - a ((i - j) + (j - i))

/-- With the natural normalization `a 0 = 0`, diagonal positivity of the
centered matrix already forces termwise positivity of the sequence. -/
theorem sequence_nonneg_of_centered_diagonal_nonneg
    {a : ℕ → ℝ} (ha0 : a 0 = 0)
    (hdiag : ∀ n, 0 ≤ centeredSequenceEntry a n n) :
    ∀ n, 0 ≤ a n := by
  intro n
  have hn := hdiag n
  simp [centeredSequenceEntry, ha0] at hn
  linarith

/-- A centered unit-circle Li distance is the inner product of two explicit
two-dimensional feature vectors. -/
theorem liAngleGramEntry_eq_rankTwo (x y : ℝ) :
    liAngleGramEntry x y =
      (1 - Real.cos x) * (1 - Real.cos y) + Real.sin x * Real.sin y := by
  unfold liAngleGramEntry liAngleMode
  rw [Real.cos_sub]
  ring

/-- Every finite quadratic form built from one angle is a sum of two squares.
This is a literal Gram/SOS certificate, not a numerical PSD test. -/
theorem liAngleGram_quadratic_eq_squares
    {ι : Type*} (s : Finset ι) (c x : ι → ℝ) :
    (∑ i ∈ s, ∑ j ∈ s, c i * c j * liAngleGramEntry (x i) (x j)) =
      (∑ i ∈ s, c i * (1 - Real.cos (x i))) ^ 2 +
      (∑ i ∈ s, c i * Real.sin (x i)) ^ 2 := by
  simp_rw [liAngleGramEntry_eq_rankTwo, mul_add, Finset.sum_add_distrib]
  rw [pow_two, pow_two, Finset.sum_mul_sum, Finset.sum_mul_sum]
  congr 1 <;>
    apply Finset.sum_congr rfl <;> intro i hi <;>
    apply Finset.sum_congr rfl <;> intro j hj <;>
    ring

/-- Hence the distance-Gram quadratic form of one unit-circle mode is
nonnegative for arbitrary finite coefficients. -/
theorem liAngleGram_quadratic_nonneg
    {ι : Type*} (s : Finset ι) (c x : ι → ℝ) :
    0 ≤ ∑ i ∈ s, ∑ j ∈ s, c i * c j * liAngleGramEntry (x i) (x j) := by
  rw [liAngleGram_quadratic_eq_squares]
  positivity

end RiemannLab
