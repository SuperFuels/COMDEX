/* -------------------------------------------------------------------------- */
/* Selection states */
/* -------------------------------------------------------------------------- */

.panel-selected {
  border-color: #000000;
  box-shadow: inset 0 0 0 0.5px #000000;
}

.list-item-selected,
.run-row-selected {
  border-color: #000000;
  background: #f1f1ed;
  box-shadow: inset 0 0 0 0.5px #000000;
}

#liveRunInspector {
  scroll-margin-top: 20px;
  outline: none;
}

#liveRunInspector:focus {
  box-shadow: inset 0 0 0 1px #000000;
}

.run-row-pulse {
  animation: runPulse 1.2s ease;
}

@keyframes runPulse {
  0% {
    box-shadow: inset 0 0 0 0 rgba(0, 0, 0, 0.25);
  }
  50% {
    box-shadow: inset 0 0 0 4px rgba(0, 0, 0, 0.08);
  }
  100% {
    box-shadow: inset 0 0 0 0 rgba(0, 0, 0, 0);
  }
}

