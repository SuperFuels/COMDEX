:root {
  --bg: #f5f3ee;
  --bg-soft: #f8f6f1;
  --panel: #fbfaf6;
  --panel-2: #f7f5ef;
  --line: rgba(15, 23, 42, 0.06);
  --line-strong: rgba(15, 23, 42, 0.14);
  --text: #111111;
  --text-soft: rgba(17, 17, 17, 0.66);
  --text-faint: rgba(17, 17, 17, 0.46);
  --accent: #647a66;
  --accent-strong: #4f6651;
  --accent-soft: rgba(100, 122, 102, 0.12);
  --blue-soft: rgba(37, 99, 235, 0.08);
  --success: #2f6b4f;
  --warn: #9a6a19;
  --danger: #a33f34;
  --radius-sm: 0;
  --radius-md: 0;
  --radius-lg: 0;
  --radius-xl: 0;
  --shadow-none: none;
  --font-ui: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-display: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, "Times New Roman", serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  --border-thin: 0.5px;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  min-height: 100%;
  font-family: var(--font-ui);
  background: var(--bg);
  color: var(--text);
}

body {
  min-height: 100vh;
}

button,
input,
textarea {
  font: inherit;
}

button {
  appearance: none;
  -webkit-appearance: none;
  border-radius: 0;
}

.desktop-root {
  min-height: 100vh;
  background: var(--bg);
}

/* -------------------------------------------------------------------------- */
/* Top bar */
/* -------------------------------------------------------------------------- */

.desktop-topbar {
  display: none;
}

.desktop-brand {
  width: 260px;
  display: flex;
  align-items: center;
}

.desktop-brand-mark {
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #ffffff;
  font-style: normal;
}

.desktop-nav-shell {
  display: none;
}

.desktop-nav-arrow {
  width: 44px;
  height: 42px;
  border: 0;
  border-left: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  color: var(--text-soft);
  cursor: default;
  font-family: var(--font-mono);
  font-size: 16px;
}

.desktop-nav-arrow:first-child {
  border-left: 0;
  border-right: var(--border-thin) solid var(--line-strong);
}

.desktop-nav-center {
  display: flex;
  align-items: stretch;
  gap: 0;
  padding: 0;
}

.desktop-nav-link {
  border: 0;
  border-left: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  color: var(--text);
  padding: 0 18px;
  min-height: 42px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-family: var(--font-mono);
}

.desktop-nav-link:first-child {
  border-left: 0;
}

.desktop-nav-link-active {
  background: #000000;
  color: #ffffff;
  border-left: var(--border-thin) solid var(--line-strong);
  box-shadow: none;
}

/* -------------------------------------------------------------------------- */
/* Status */
/* -------------------------------------------------------------------------- */

.status-banner {
  display: none;
}

.status-banner-title {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  margin-bottom: 6px;
  font-family: var(--font-mono);
  color: var(--text);
}

.status-banner-copy {
  font-size: 14px;
  color: var(--text);
  line-height: 1.35;
}

.status-banner-neutral .status-banner-title,
.status-banner-success .status-banner-title,
.status-banner-error .status-banner-title {
  color: var(--text);
}

/* -------------------------------------------------------------------------- */
/* Surface shell */
/* -------------------------------------------------------------------------- */

.surface-shell {
  padding: 18px 20px 20px;
}

.surface-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18px;
  padding: 18px 20px;
  border: var(--border-thin) solid var(--line-strong);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.surface-header-unified {
  display: grid;
  gap: 8px;
  border: 0;
  padding: 0 0 4px 0;
  background: transparent;
}

.surface-header-unified-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18px;
  padding: 0;
  border-bottom: 0;
}

.surface-header-unified-main {
  display: block;
  padding: 0;
}

.surface-runtime-copy {
  margin-top: 4px;
  font-size: 14px;
  line-height: 1.35;
  color: var(--text);
}

.surface-eyebrow {
  font-size: 11px;
  color: var(--text);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-family: var(--font-mono);
}

.surface-title {
  font-family: var(--font-mono);
  font-size: 22px;
  line-height: 1.05;
  font-weight: 700;
  color: var(--text);
  margin-top: 8px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.surface-subtitle {
  margin-top: 10px;
  font-size: 14px;
  color: var(--text-soft);
  max-width: 760px;
  line-height: 1.45;
}

.surface-right-meta {
  display: grid;
  gap: 8px;
  justify-items: end;
}

.surface-pill {
  border-radius: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--text);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-family: var(--font-mono);
}

.last-refresh {
  font-size: 12px;
  color: var(--text-soft);
  font-family: var(--font-mono);
}

/* -------------------------------------------------------------------------- */
/* Tabs */
/* -------------------------------------------------------------------------- */

.app-tabs {
  display: flex;
  gap: 0;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 16px 0 12px;
}

.app-tab {
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  border-left-width: 0;
  background: #ffffff;
  color: var(--text);
  padding: 11px 18px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: none;
  transition: none;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
}

.app-tab:first-child {
  border-left-width: var(--border-thin);
}

.app-tab-active {
  background: #000000;
  color: #ffffff;
  border-color: var(--line-strong);
}

/* -------------------------------------------------------------------------- */
/* Buttons */
/* -------------------------------------------------------------------------- */

.primary-btn,
.secondary-btn {
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  padding: 10px 14px;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
  transition: none;
  box-shadow: none;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
}

.primary-btn:hover,
.secondary-btn:hover,
.app-tab:hover,
.desktop-nav-link:hover {
  filter: none;
}

.primary-btn {
  width: 100%;
  background: #000000;
  color: #ffffff;
  border-color: #000000;
}

.primary-btn:hover {
  background: #111111;
  border-color: #111111;
}

.secondary-btn {
  background: #ffffff;
  color: var(--text);
}

.secondary-btn:hover,
.app-tab:hover {
  background: #000000;
  color: #ffffff;
}

.secondary-btn-small {
  padding: 7px 10px;
  font-size: 11px;
  flex: 0 0 auto;
}

/* -------------------------------------------------------------------------- */
/* Layout */
/* -------------------------------------------------------------------------- */

.desktop-layout {
  display: grid;
  grid-template-columns: 300px minmax(0, 1fr);
  gap: 16px;
  min-height: calc(100vh - 180px);
}

.sidebar {
  display: grid;
  align-content: start;
  gap: 16px;
}

.main-content {
  display: grid;
  gap: 16px;
}

/* -------------------------------------------------------------------------- */
/* Panels / cards */
/* -------------------------------------------------------------------------- */

.panel,
.card,
.placeholder-card {
  background: #ffffff;
  border: var(--border-thin) solid var(--line-strong);
  border-radius: 0;
  padding: 16px;
  box-shadow: none;
  backdrop-filter: none;
}

.panel-title,
.card-label,
.placeholder-label {
  font-size: 11px;
  color: var(--text);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  margin-bottom: 12px;
  font-family: var(--font-mono);
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.card {
  min-height: 110px;
}

.card-value {
  font-family: var(--font-display);
  font-size: 30px;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
  letter-spacing: 0.01em;
}

.card-sub {
  margin-top: 10px;
  font-size: 13px;
  color: var(--text-soft);
  line-height: 1.4;
}

.two-col,
.placeholder-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.three-col {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.large-panel,
.placeholder-card-large {
  min-height: 260px;
}

/* -------------------------------------------------------------------------- */
/* Inputs */
/* -------------------------------------------------------------------------- */

.field-label {
  display: block;
  font-size: 11px;
  color: var(--text);
  margin-bottom: 6px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-family: var(--font-mono);
}

.input {
  width: 100%;
  margin-bottom: 12px;
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  color: var(--text);
  padding: 11px 12px;
  outline: none;
  font-size: 14px;
  box-shadow: none;
}

.input:focus {
  border-color: #000000;
  background: #ffffff;
  box-shadow: none;
}

.input-textarea {
  min-height: 110px;
  resize: vertical;
}

.input-textarea-small {
  min-height: 86px;
}

.button-grid {
  display: grid;
  gap: 10px;
}

.helper-text {
  margin-top: 10px;
  font-size: 12px;
  color: var(--text-soft);
  line-height: 1.45;
}

/* -------------------------------------------------------------------------- */
/* Key/value */
/* -------------------------------------------------------------------------- */

.kv-row {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 0;
  border-top: var(--border-thin) solid var(--line);
  font-size: 13px;
  color: var(--text-soft);
}

.kv-row strong {
  color: var(--text);
  font-family: var(--font-mono);
  font-weight: 700;
}

.kv-row:first-of-type {
  border-top: 0;
}

/* -------------------------------------------------------------------------- */
/* Lists */
/* -------------------------------------------------------------------------- */

.compact-section {
  display: grid;
  gap: 12px;
}

.compact-list {
  display: grid;
  gap: 0;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
}

.compact-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  padding: 12px 14px;
  border-top: var(--border-thin) solid var(--line-strong);
}

.compact-row:first-child {
  border-top: 0;
}

.compact-row-main {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  font-size: 14px;
  line-height: 1.35;
  color: var(--text);
  font-family: var(--font-mono);
}

.compact-row-main strong {
  font-weight: 700;
}

.compact-row-meta {
  color: var(--text-soft);
}

.compact-row-action {
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  color: var(--text);
  padding: 6px 10px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
}

.compact-row-action:hover {
  background: #000000;
  color: #ffffff;
}

.compact-more-btn {
  border: 0;
  background: transparent;
  color: var(--text);
  padding: 0;
  font-size: 14px;
  font-weight: 700;
  text-align: left;
  cursor: pointer;
  font-family: var(--font-mono);
}

.compact-more-btn:hover {
  text-decoration: underline;
}

.compact-status {
  display: inline-block;
  font-weight: 700;
  text-transform: lowercase;
  font-family: var(--font-mono);
}

.compact-status-completed,
.compact-status-approved,
.compact-status-failed,
.compact-status-rejected,
.compact-status-running,
.compact-status-waiting_approval,
.compact-status-pending,
.compact-status-queued {
  color: var(--text);
}

.list-wrap {
  display: grid;
  gap: 10px;
}

.list-item {
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  padding: 14px 15px;
  display: grid;
  gap: 8px;
  box-shadow: none;
}

.list-item-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  word-break: break-word;
  line-height: 1.22;
}

.list-item-sub {
  font-size: 12px;
  color: var(--text-soft);
  word-break: break-word;
  line-height: 1.45;
}

/* -------------------------------------------------------------------------- */
/* Badges */
/* -------------------------------------------------------------------------- */

.badge-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.badge,
.status-badge {
  border-radius: 0;
  padding: 5px 8px;
  font-size: 10px;
  font-weight: 700;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  color: var(--text);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
}

.status-running,
.status-completed,
.status-approved,
.status-cancelled,
.status-idle,
.status-waiting_approval,
.status-pending,
.status-failed,
.status-rejected {
  background: #ffffff;
  border-color: var(--line-strong);
  color: var(--text);
}

/* -------------------------------------------------------------------------- */
/* Code / empty */
/* -------------------------------------------------------------------------- */

.json-block {
  margin: 0;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 12px;
  line-height: 1.5;
  color: var(--text);
  max-height: 560px;
  overflow: auto;
  font-family: var(--font-mono);
}

.empty-state {
  font-size: 13px;
  color: var(--text-soft);
  padding: 8px 0;
  line-height: 1.45;
}

.placeholder-headline {
  font-family: var(--font-display);
  font-size: 40px;
  line-height: 0.98;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.02em;
  margin-bottom: 12px;
  text-transform: uppercase;
}

.placeholder-copy {
  font-size: 14px;
  color: var(--text-soft);
  max-width: 680px;
  line-height: 1.6;
}

.placeholder-list {
  display: grid;
  gap: 8px;
  color: var(--text-soft);
  font-size: 14px;
}

/* -------------------------------------------------------------------------- */
/* Dashboard */
/* -------------------------------------------------------------------------- */

.dashboard-shell {
  display: grid;
  gap: 16px;
}

.dashboard-department-grid {
  display: grid;
  gap: 12px;
}

.dashboard-department-card {
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  padding: 16px;
  display: grid;
  gap: 14px;
  box-shadow: none;
}

.dashboard-department-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.dashboard-department-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
  text-transform: uppercase;
  font-family: var(--font-mono);
}

.dashboard-department-sub {
  margin-top: 4px;
  font-size: 13px;
  color: var(--text-soft);
  line-height: 1.45;
}

.dashboard-department-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.dashboard-mini-stat {
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  padding: 10px 12px;
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: center;
}

.dashboard-mini-stat span {
  font-size: 12px;
  color: var(--text-soft);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
}

.dashboard-mini-stat strong {
  font-size: 14px;
  color: var(--text);
  font-family: var(--font-mono);
}

/* -------------------------------------------------------------------------- */
/* Marketing */
/* -------------------------------------------------------------------------- */

.marketing-form-grid {
  margin-top: 6px;
  margin-bottom: 12px;
}

.marketing-form-actions {
  margin-top: 14px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.marketing-runs-grid {
  display: grid;
  gap: 12px;
}

.marketing-run-card {
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  padding: 16px;
  display: grid;
  gap: 12px;
  box-shadow: none;
}

.marketing-run-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.marketing-run-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.25;
}

.marketing-run-meta {
  margin-top: 4px;
  font-size: 12px;
  color: var(--text-soft);
  font-family: var(--font-mono);
}

.marketing-run-brief {
  font-size: 13px;
  color: var(--text-soft);
  line-height: 1.55;
}

.marketing-carousel-list {
  display: grid;
  gap: 8px;
}

.marketing-carousel-item {
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  padding: 10px 12px;
  display: grid;
  gap: 4px;
}

.marketing-carousel-item strong {
  font-size: 10px;
  color: var(--text);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-family: var(--font-mono);
}

.marketing-carousel-item span {
  font-size: 13px;
  color: var(--text);
}

.marketing-error {
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  color: var(--text);
  padding: 10px 12px;
  font-size: 12px;
  line-height: 1.45;
}

.marketing-approval-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 10px;
}

/* -------------------------------------------------------------------------- */
/* Embedded surfaces */
/* -------------------------------------------------------------------------- */

.embedded-surface-shell {
  display: grid;
  gap: 12px;
  min-height: calc(100vh - 230px);
}

.embedded-surface-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 0;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  box-shadow: none;
}

.embedded-surface-url {
  min-width: 0;
  font-size: 12px;
  color: var(--text-soft);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: var(--font-mono);
}

.business-surface-frame {
  width: 100%;
  min-height: calc(100vh - 300px);
  border: var(--border-thin) solid var(--line-strong);
  border-radius: 0;
  background: #ffffff;
  box-shadow: none;
}

/* -------------------------------------------------------------------------- */
/* Scrollbar */
/* -------------------------------------------------------------------------- */

::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

::-webkit-scrollbar-track {
  background: #e7e7e2;
  border-radius: 0;
}

::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.35);
  border-radius: 0;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 0, 0, 0.55);
}

/* -------------------------------------------------------------------------- */
/* Boardroom / mode toggles */
/* -------------------------------------------------------------------------- */

.boardroom-mode-toggle,
.boardroom-view-toggle {
  display: flex;
  gap: 0;
  padding: 0 0 14px 0;
  flex-wrap: wrap;
}

.boardroom-view-btn {
  border-left-width: 0;
}

.boardroom-view-btn:first-child {
  border-left-width: var(--border-thin);
}

.boardroom-view-btn-active {
  border-color: var(--line-strong);
  background: #000000;
  color: #ffffff;
}

.boardroom-dashboard-shell {
  display: grid;
  gap: 16px;
}

/* -------------------------------------------------------------------------- */
/* Spatial */
/* -------------------------------------------------------------------------- */

.spatial-boardroom-shell {
  display: grid;
  gap: 16px;
  width: 100%;
  min-height: 720px;
}

.spatial-boardroom-mount {
  position: relative;
  width: 100%;
  min-height: 720px;
  height: calc(100vh - 280px);
  border-radius: 0;
  overflow: hidden;
  border: var(--border-thin) solid var(--line-strong);
  background: #ffffff;
  box-shadow: none;
}

.spatial-boardroom-mount canvas {
  display: block;
  width: 100% !important;
  height: 100% !important;
}

/* -------------------------------------------------------------------------- */
/* Operations */
/* -------------------------------------------------------------------------- */

.operations-flow-shell {
  display: flex;
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
}

.operations-flow-mount {
  position: relative;
  flex: 1 1 auto;
  width: 100%;
  min-height: 720px;
