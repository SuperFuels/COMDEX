{
  "schema_version": "tessaris.business-data-discovery-scenarios.v1",
  "privacy": "scenario identifiers, expected domains and assertions only; never record customer values",
  "scenarios": [
    {
      "session_id": "business-onboarding",
      "scenario_id": "create-business-through-onboarding-pilot",
      "execution_surfaces": ["desktop_renderer", "desktop_backend"],
      "journey_steps": ["create a new business", "complete and resume the onboarding Pilot", "save brand and initial operating context"],
      "expected_domains": ["business.identity", "business.structure", "business.map", "business.working_state", "departments.map", "departments.intelligence", "onboarding.foundation_session", "onboarding.receipts"],
      "expected_external_classes": ["secret_store"],
      "completion_assertions": ["restart restores the approved business and Pilot state", "no onboarding payload remains authoritative in browser storage"]
    },
    {
      "session_id": "identity-access",
      "scenario_id": "founder-role-device-and-recovery",
      "execution_surfaces": ["desktop_renderer", "desktop_backend", "electron_main"],
      "journey_steps": ["create founder authority", "bind a device", "exercise lock and recovery metadata"],
      "expected_domains": ["business.map", "business.structure", "business.working_state", "departments.map", "departments.intelligence", "departments.operational_records", "security.records", "security.audit"],
      "expected_external_classes": ["secret_store"],
      "completion_assertions": ["secrets remain outside the Vault", "identity and authority records restart from Guardian"]
    },
    {
      "session_id": "settings-configuration",
      "scenario_id": "edit-business-settings-and-add-future-department",
      "execution_surfaces": ["desktop_renderer", "desktop_backend"],
      "journey_steps": ["edit business settings", "change a policy", "add an arbitrary new department introduced after installation"],
      "expected_domains": ["business.identity", "business.map", "business.working_state", "departments.map", "departments.intelligence", "departments.operational_audit"],
      "expected_external_classes": ["none"],
      "completion_assertions": ["new department survives restart", "new department uses wildcard Guardian domains", "setting history remains versioned"]
    },
    {
      "session_id": "crm-customers",
      "scenario_id": "create-edit-and-reopen-customer",
      "execution_surfaces": ["desktop_renderer", "desktop_backend"],
      "journey_steps": ["create customer", "edit contact and service address", "reopen customer history"],
      "expected_domains": ["business.map", "business.working_state", "departments.intelligence", "departments.map", "departments.operational_records", "finance.integration_records", "finance.sales_records", "sales.audit", "sales.completion_records", "sales.records", "security.records"],
      "expected_external_classes": ["none"],
      "completion_assertions": ["customer changes restart from Guardian", "quote and work views reuse the same customer identity"]
    },
    {
      "session_id": "lead-booking-intake",
      "scenario_id": "capture-and-convert-booking-intake",
